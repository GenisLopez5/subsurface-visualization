# Copy to .env (next to where you start the server, or any parent folder) and fill in.
# Postgres for the /api/v1 file API (e.g. Tiger Data). Without it /api/v1 answers 503.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# Optional
# LITHO_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# LITHO_MAX_UPLOAD_MB=200
# Bounding-box service (bbox-final/server.py on another machine); without it, no automatic boxes
# LITHO_BBOX_URL=http://192.168.1.50:8100
# LITHO_BBOX_TIMEOUT=300
# LITHO_DETECTOR=package.module:object
