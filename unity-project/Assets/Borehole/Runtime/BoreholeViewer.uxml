<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Borehole/Runtime/BoreholeViewer.uss?fileID=7433441132597879392&amp;guid=124ae03cf12f30147b53525a41224268&amp;type=3#BoreholeViewer"/>
    <ui:VisualElement class="app">
        <ui:VisualElement class="header">
            <ui:VisualElement class="source">
                <ui:Label name="filename" class="filename"/>
                <ui:Label name="range" class="source-range"/>
                <ui:VisualElement name="composition" class="composition hidden"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="error" class="error hidden"/>
        <ui:VisualElement class="workspace">
            <ui:VisualElement name="documentView" class="document-pane">
                <ui:VisualElement name="documentViewport" class="document-viewport">
                    <ui:Image name="documentImage" picking-mode="Ignore" class="document-image"/>
                    <ui:VisualElement name="documentTiles" picking-mode="Ignore" class="document-tiles"/>
                    <ui:VisualElement name="documentWindow" picking-mode="Ignore" class="document-window"/>
                    <ui:VisualElement name="documentSelection" picking-mode="Ignore" class="document-selection"/>
                    <ui:VisualElement name="documentPlaceholder" picking-mode="Ignore" class="placeholder">
                        <ui:Label text="THE SOURCE, IN CONTEXT" class="placeholder-title"/>
                        <ui:Label text="Load the segmented document to link image pixels with depth. The cylinder remains available while you choose a page." class="placeholder-copy"/>
                    </ui:VisualElement>
                    <ui:Label name="documentNotice" picking-mode="Ignore" class="document-notice"/>
                    <ui:VisualElement name="csvOverlay" class="csv-overlay hidden">
                        <ui:VisualElement class="csv-toolbar">
                            <ui:Label text="CSV"/>
                            <ui:Button name="downloadCsv" text="Download CSV" tooltip="Save the original CSV for this document"/>
                            <ui:Button name="hideCsv" text="Close"/>
                        </ui:VisualElement>
                        <ui:ScrollView name="csvHorizontal" mode="Horizontal">
                            <ui:VisualElement name="csvHeader" class="csv-row"/>
                            <ui:ListView name="csvRows"/>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="pane-footer">
                    <ui:Button name="toggleCsv" text="CSV"/>
                    <ui:Button name="toggleAnnotations" text="Annotations: on" tooltip="An unannotated source image is required to hide generated annotations"/>
                    <ui:Button name="focusDocument" text="Focus document" tooltip="Expand document; Escape restores split view"/>
                    <ui:Label name="pixelReadout"/>
                    <ui:Label name="syncState"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="column-pane">
                <ui:VisualElement name="viewport" class="viewport">
                    <ui:Image name="renderImage" picking-mode="Ignore" class="render-image"/>
                    <ui:Label name="labelHint" text="Zoom in to see section labels" picking-mode="Ignore" class="label-hint hidden"/>
                    <ui:Label name="surfaceGap" picking-mode="Ignore" class="surface-gap hidden"/>
                    <ui:VisualElement name="ruler" picking-mode="Ignore" class="ruler"/>
                    <ui:VisualElement name="intervalLabels" picking-mode="Ignore" class="annotation-layer"/>
                    <ui:VisualElement name="selectionCard" picking-mode="Ignore" class="selection-card hidden">
                        <ui:Label text="SELECTED INTERVAL" class="selection-caption"/>
                        <ui:Label name="selectedName" class="selected-name"/>
                        <ui:Label name="selectedDepths" class="selected-depths"/>
                        <ui:Label name="selectedInfo" class="selected-info"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="navigation" class="navigation">
                    <ui:Slider name="zoomSlider" low-value="0" high-value="1" class="zoom-slider"/>
                    <ui:Label name="zoomPercent" class="zoom-percent"/>
                    <ui:Button name="fit" text="Fit"/>
                    <ui:DropdownField name="appearance" class="appearance"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="footer">
            <ui:Label name="depthReadout" class="depth-readout"/>
            <ui:Label name="status" class="status"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
